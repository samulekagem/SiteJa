<html lang="pt-BR"><head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Site Já — sua página, seus links, seu negócio.">
  <title>Site Já — Sua página em um só lugar</title>
  <style>
    :root{
      --bg:#070a12;
      --card:rgba(18,24,38,.72);
      --card-hover:rgba(27,35,54,.9);
      --text:#f7f9ff;
      --muted:#aab4c7;
      --blue:#20b8ff;
      --blue2:#356cff;
      --border:rgba(255,255,255,.09);
      --shadow:0 24px 70px rgba(0,0,0,.45);
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      min-height:100vh;
      font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
      color:var(--text);
      background:
        radial-gradient(circle at 50% 0%, rgba(32,184,255,.15), transparent 34%),
        radial-gradient(circle at 100% 50%, rgba(53,108,255,.09), transparent 30%),
        var(--bg);
      display:flex;
      justify-content:center;
      padding:28px 16px 36px;
    }
    .page{width:100%;max-width:520px}
    .brand{
      display:flex;align-items:center;justify-content:center;gap:10px;
      margin:8px 0 24px;
      font-weight:800;letter-spacing:-.04em;font-size:20px;
    }
    .brand-mark{
      width:34px;height:34px;border-radius:10px;
      display:grid;place-items:center;
      background:linear-gradient(135deg,var(--blue),var(--blue2));
      box-shadow:0 8px 28px rgba(32,184,255,.28);
      font-weight:900;
    }
    .profile{text-align:center}
    .avatar{
      width:92px;height:92px;border-radius:50%;
      margin:0 auto 16px;
      display:grid;place-items:center;
      overflow:hidden;
      background:#070a12;
      border:4px solid rgba(255,255,255,.08);
      box-shadow:0 12px 40px rgba(32,184,255,.22);
    }
    .avatar img{
      width:100%;height:100%;object-fit:cover;display:block;
    }
    h1{font-size:30px;line-height:1.05;margin:0 0 8px;letter-spacing:-.055em}
    .handle{color:var(--blue);font-weight:700;font-size:14px;margin-bottom:10px}
    .bio{margin:0 auto;max-width:430px;color:var(--muted);line-height:1.55;font-size:15px}
    .socials{display:flex;justify-content:center;gap:10px;margin:20px 0 26px}
    .socials a{
      width:42px;height:42px;border:1px solid var(--border);
      background:rgba(255,255,255,.045);border-radius:13px;
      display:grid;place-items:center;color:var(--text);
      text-decoration:none;font-weight:800;font-size:13px;
      transition:.2s;
    }
    .socials a:hover{transform:translateY(-2px);background:var(--card-hover);border-color:rgba(32,184,255,.4)}
    .links{display:grid;gap:12px}
    .link{
      min-height:62px;padding:10px 14px 10px 18px;
      display:flex;align-items:center;gap:14px;
      color:var(--text);text-decoration:none;
      border:1px solid var(--border);
      border-radius:18px;background:var(--card);
      backdrop-filter:blur(14px);
      box-shadow:0 10px 30px rgba(0,0,0,.15);
      transition:transform .2s,border-color .2s,background .2s;
    }
    .link:hover{transform:translateY(-2px);background:var(--card-hover);border-color:rgba(32,184,255,.35)}
    .icon{
      width:40px;height:40px;border-radius:12px;display:grid;place-items:center;
      background:rgba(32,184,255,.11);color:var(--blue);font-weight:900;font-size:18px;
      flex:none;
    }
    .link-text{flex:1;text-align:center;font-weight:750;font-size:15px;margin-left:-40px}
    .arrow{color:#76839b;font-size:18px}
    .featured{
      background:linear-gradient(135deg,rgba(32,184,255,.18),rgba(53,108,255,.16));
      border-color:rgba(32,184,255,.32);
    }
    .featured .icon{background:linear-gradient(135deg,var(--blue),var(--blue2));color:white}
    .section-title{
      color:#78859a;text-transform:uppercase;letter-spacing:.14em;
      font-size:11px;font-weight:800;margin:28px 4px 11px;
    }
    .footer{text-align:center;margin-top:30px;color:#6e7a90;font-size:12px}
    .footer strong{color:#aeb9ca}
    @media(max-width:380px){
      h1{font-size:27px}
      .link{min-height:58px}
    }
  </style>
<style id="__web-inspector-hide-shortcut-style__">
.__web-inspector-hide-shortcut__, .__web-inspector-hide-shortcut__ *
{
    visibility: hidden !important;
}
</style></head>
<body>
  <main class="page">
    

    <section class="profile">
      <div class="avatar"><img src="siteja-logo.png" alt="Logo Site Já"></div>
      <h1>Site Já</h1>
      <div class="handle">@siteja</div>
      <p class="bio">Sua página. Seus links. Seu negócio.<br>Uma presença online simples, bonita e profissional.</p>

      <nav class="socials" aria-label="Redes sociais">
        <a href="https://instagram.com/" target="_blank" aria-label="Instagram" style="border-top-width: 1px;padding-left: 0px;margin-top: 0px;" class="">IG</a>
        <a href="https://wa.me/" target="_blank" aria-label="WhatsApp">WA</a>
        <a href="https://tiktok.com/" target="_blank" aria-label="TikTok">TK</a>
      </nav>
    </section>

    <section class="links" aria-label="Links principais">
      <a class="link featured" href="https://wa.me/31981161191" target="_blank">
        <span class="icon">↗</span>
        <span class="link-text">Fale conosco no WhatsApp</span>
        <span class="arrow">›</span>
      </a>

      

      

      

      
    </section>

    <div class="section-title" id="servicos">Sobre a Site Já</div>
    <section class="links">
      <a class="link" href="#">
        <span class="icon">✓</span>
        <span class="link-text">Páginas personalizadas</span>
        <span class="arrow">›</span>
      </a>
      <a class="link" href="#">
        <span class="icon">⚡</span>
        <span class="link-text">Criação rápida e sem complicação</span>
        <span class="arrow">›</span>
      </a>
    </section>

    <footer class="footer">
      Criado por <strong>Site Já</strong></footer>
  </main>


</body></html>
